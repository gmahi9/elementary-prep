{
  "name": "elementary-prep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "gmahi9",
  "license": "MIT",
  "description": "Unofficial elementary practice and test prep for kindergarten through grade 5.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "generate": "node scripts/generate-grade3.mjs",
    "seed:sql": "node scripts/seed-sql.mjs",
    "seed:local": "node scripts/seed-sql.mjs && npx wrangler d1 migrations apply elementary-prep --local && npx wrangler d1 execute elementary-prep --local --file=seeds/out/questions.sql"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
